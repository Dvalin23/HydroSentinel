@page
@model HydroSentinel.Pages.Account.ResetPasswordModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Reset password"; }
<section class="auth-main"><div class="shell"><div class="auth-panel">
    <p class="auth-eyebrow">Account recovery</p>
    <h1>Choose a new password</h1>
    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-notice" role="alert"></div>
        <input asp-for="Input.UserId" type="hidden" />
        <input asp-for="Input.Code" type="hidden" />
        <div class="auth-field"><label asp-for="Input.Password">New password</label><input asp-for="Input.Password" type="password" autocomplete="new-password" required /><span asp-validation-for="Input.Password"></span></div>
        <div class="auth-field"><label asp-for="Input.ConfirmPassword">Confirm new password</label><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required /><span asp-validation-for="Input.ConfirmPassword"></span></div>
        <button class="button button-primary auth-submit" type="submit">Reset password</button>
    </form>
    @if (Model.StatusMessage is not null) { <p class="auth-notice" role="alert">@Model.StatusMessage <a asp-page="/Account/ForgotPassword">Request a new link</a>.</p> }
</div></div></section>
