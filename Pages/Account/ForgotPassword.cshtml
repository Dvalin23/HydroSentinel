@page
@model HydroSentinel.Pages.Account.ForgotPasswordModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Forgot password"; }
<section class="auth-main"><div class="shell"><div class="auth-panel">
    <p class="auth-eyebrow">Account recovery</p>
    <h1>Reset your password</h1>
    <p>Enter your account email. If it is confirmed, we will send a secure reset link.</p>
    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-notice" role="alert"></div>
        <div class="auth-field"><label asp-for="Input.Email">Email address</label><input asp-for="Input.Email" type="email" autocomplete="email" required /><span asp-validation-for="Input.Email"></span></div>
        <button class="button button-primary auth-submit" type="submit">Send reset link</button>
    </form>
    @if (Model.StatusMessage is not null) { <p class="auth-notice" role="status">@Model.StatusMessage</p> }
    <p class="auth-secondary"><a asp-page="/Login">Return to sign in</a></p>
</div></div></section>
