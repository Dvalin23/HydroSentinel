@page
@model HydroSentinel.Pages.Admin.AdminPageModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Support"; var openCount = Model.SupportTickets.Count(x => x.Status != HydroSentinel.Data.SupportTicketStatus.Resolved); }
<div class="admin-page-head"><div><p class="admin-page-kicker">Service desk</p><h1>Support queue</h1><p>Review customer requests and respond from their account conversation.</p></div><span class="admin-title-pill">@openCount open</span></div>
@if (Model.SupportTickets.Count == 0) { <div class="admin-state"><strong>No support requests</strong><p>Customer support requests will appear here.</p></div> }
else { <div class="admin-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Reference</th><th>Subject</th><th>Category</th><th>Updated</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var ticket in Model.SupportTickets) { <tr><td><strong>@ticket.Reference</strong></td><td>@ticket.Subject</td><td>@ticket.Category</td><td>@ticket.UpdatedAt.LocalDateTime.ToString("g")</td><td><span class="admin-status open">@ticket.Status</span></td><td><a asp-page="/Admin/Support/Details" asp-route-id="@ticket.Reference">Open</a></td></tr> }
</tbody></table></div></div> }
