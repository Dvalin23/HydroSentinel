@page
@model HydroSentinel.Pages.Customer.Support.DetailsModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Support Ticket"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-account-support.css" asp-append-version="true" /> }
<section class="stage7-intro"><div><p class="customer-eyebrow">Support request · @Model.Ticket.Reference</p><h2>@Model.Ticket.Subject</h2><p class="customer-lede">@Model.Ticket.Category · Created @Model.Ticket.CreatedAt.LocalDateTime.ToString("g")@(Model.DeviceName is null ? "" : " · " + Model.DeviceName)</p></div><span class="customer-status-badge"><span></span>@Model.Ticket.Status</span></section>
<section class="stage7-panel"><div class="stage7-panel-head"><div><h3>Conversation</h3><p>Replies are visible to you and the support team.</p></div><a class="customer-button customer-button-secondary" asp-page="/Customer/Support">Back to requests</a></div><div class="stage7-panel-body stage7-stack">
    @if (TempData["SupportStatus"] is string status) { <div class="stage7-test-confirmation" role="status">@status</div> }
    @foreach (var message in Model.Ticket.Messages) { <article class="stage7-callout"><strong>@(message.IsStaffReply ? "Firmlon Support" : "You") · @message.CreatedAt.LocalDateTime.ToString("g")</strong><p style="white-space:pre-wrap">@message.Body</p></article> }
    <form method="post" asp-page-handler="Reply" class="stage7-form">
        <div asp-validation-summary="ModelOnly" class="stage7-validation" role="alert"></div>
        <div class="stage7-field"><label asp-for="Input.Message"></label><textarea asp-for="Input.Message"></textarea><span asp-validation-for="Input.Message" class="stage7-validation"></span></div>
        <div class="stage7-form-actions"><button class="customer-button customer-button-primary" type="submit">Add reply</button></div>
    </form>
</div></section>
