@page
@model HydroSentinel.Pages.Customer.Support.IndexModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Support"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-account-support.css" asp-append-version="true" /> }
<section class="stage7-intro"><div><p class="customer-eyebrow">Support centre</p><h2>Help when your water system needs it.</h2><p class="customer-lede">Review your support requests and replies.</p></div><span class="customer-status-badge"><span></span>Account support</span></section>
<div class="stage7-grid">
    <section class="stage7-panel">
        <div class="stage7-panel-head"><div><h3>Your requests</h3><p>Only tickets belonging to your account appear here.</p></div><a class="customer-button customer-button-primary" asp-page="/Customer/Support/Create">Create request</a></div>
        <div class="stage7-panel-body stage7-stack">
            @if (Model.Tickets.Count == 0) { <p class="stage7-note">You have no support requests yet.</p> }
            @foreach (var ticket in Model.Tickets) { <a class="stage7-link-row" asp-page="/Customer/Support/Details" asp-route-id="@ticket.Reference"><span><strong>@ticket.Subject</strong><small>@ticket.Reference · @ticket.Status · Updated @ticket.UpdatedAt.LocalDateTime.ToString("g")</small></span><em>View</em></a> }
        </div>
    </section>
    <aside class="stage7-panel"><div class="stage7-panel-head"><h3>Need an answer now?</h3></div><div class="stage7-panel-body stage7-stack"><a class="stage7-link-row" asp-page="/Customer/Help">Open Help Centre</a><a class="stage7-link-row" asp-page="/Contact">Contact Firmlon</a></div></aside>
</div>
