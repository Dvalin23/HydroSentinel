@page
@model HydroSentinel.Pages.Customer.Support.CreateModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Create Support Ticket"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-account-support.css" asp-append-version="true" /> }
<section class="stage7-intro"><div><p class="customer-eyebrow">Support centre</p><h2>Tell us how we can help.</h2><p class="customer-lede">Create a support request and follow its replies from your account.</p></div><span class="customer-status-badge"><span></span>Account support</span></section>
<div class="stage7-grid">
    <section class="stage7-panel">
        <div class="stage7-panel-head"><div><h3>New support request</h3><p>Required fields are marked in the form.</p></div></div>
        <div class="stage7-panel-body">
            <form method="post" class="stage7-form">
                <div asp-validation-summary="ModelOnly" class="stage7-validation" role="alert"></div>
                <div class="stage7-form-grid">
                    <div class="stage7-field"><label asp-for="Input.Subject"></label><input asp-for="Input.Subject" /><span asp-validation-for="Input.Subject" class="stage7-validation"></span></div>
                    <div class="stage7-field"><label asp-for="Input.Category"></label><select asp-for="Input.Category"><option value="">Select a category</option><option>Account access</option><option>Device support</option><option>Monitoring</option><option>Billing</option><option>Other</option></select><span asp-validation-for="Input.Category" class="stage7-validation"></span></div>
                    <div class="stage7-field stage7-field-full"><label asp-for="Input.DeviceId">Related device <span class="stage7-help">(optional)</span></label><select asp-for="Input.DeviceId"><option value="">No related device</option>@foreach (var device in Model.Devices) { <option value="@device.Id">@device.Name · @device.SerialMasked</option> }</select><span asp-validation-for="Input.DeviceId" class="stage7-validation"></span></div>
                    <div class="stage7-field stage7-field-full"><label asp-for="Input.Description"></label><textarea asp-for="Input.Description"></textarea><span asp-validation-for="Input.Description" class="stage7-validation"></span></div>
                </div>
                <p class="stage7-note">Your request and replies are saved to your account. Attachments are not supported. Do not include passwords, payment secrets, or private keys.</p>
                <div class="stage7-form-actions"><button class="customer-button customer-button-primary" type="submit">Submit request</button><a class="customer-button customer-button-secondary" asp-page="/Customer/Support">Back to Support</a></div>
            </form>
        </div>
    </section>
    <aside class="stage7-panel"><div class="stage7-panel-head"><div><h3>Before you submit</h3><p>Helpful context for the support team.</p></div></div><div class="stage7-panel-body"><ul class="stage7-checklist"><li><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>Include what you expected and what happened.</li><li><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>Select a related device from your account.</li><li><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>Never include passwords, payment secrets, or private keys.</li></ul></div></aside>
</div>
