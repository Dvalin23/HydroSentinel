@page
@model HydroSentinel.Pages.Customer.Settings.SecurityModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Security"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-account-support.css" asp-append-version="true" /> }

<section class="stage7-intro"><div><p class="customer-eyebrow">Account security</p><h2>Protect your account.</h2><p class="customer-lede">Change your password securely using your current password.</p></div><span class="customer-status-badge"><span></span>Identity active</span></section>
<nav class="stage7-tabs" aria-label="Settings sections">
    <a class="stage7-tab" asp-page="/Customer/Settings/Profile">Profile</a>
    <a class="stage7-tab is-active" aria-current="page" asp-page="/Customer/Settings/Security">Security</a>
    <a class="stage7-tab" asp-page="/Customer/Settings/Notifications">Notifications</a>
</nav>
<div class="stage7-grid">
    <section class="stage7-panel">
        <div class="stage7-panel-head"><div><h3>Change password</h3><p>Choose a unique password with at least 10 characters.</p></div></div>
        <div class="stage7-panel-body">
            @if (Model.StatusMessage is not null) { <p class="stage7-note" role="status">@Model.StatusMessage</p> }
            <form method="post" class="stage7-form">
                <div asp-validation-summary="ModelOnly" class="stage7-validation" role="alert"></div>
                <div class="stage7-field"><label asp-for="Input.CurrentPassword"></label><input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" /><span asp-validation-for="Input.CurrentPassword" class="stage7-validation"></span></div>
                <div class="stage7-field"><label asp-for="Input.NewPassword"></label><input asp-for="Input.NewPassword" type="password" autocomplete="new-password" /><span asp-validation-for="Input.NewPassword" class="stage7-validation"></span></div>
                <div class="stage7-field"><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword" class="stage7-validation"></span></div>
                <p class="stage7-note">Changing your password updates the security stamp. Other sessions will be rejected when their security stamp is next checked.</p>
                <div class="stage7-form-actions"><button type="submit" class="customer-button customer-button-primary">Update password</button><a class="customer-button customer-button-secondary" asp-page="/Account/ForgotPassword">Forgot password?</a></div>
            </form>
        </div>
    </section>
    <aside class="stage7-panel">
        <div class="stage7-panel-head"><div><h3>Additional security</h3><p>More sign-in controls remain to be configured.</p></div></div>
        <div class="stage7-panel-body"><div class="stage7-callout"><strong>Multi-factor authentication</strong><p>MFA is not enabled yet. It requires a product decision and a tested delivery or authenticator workflow.</p></div></div>
    </aside>
</div>
