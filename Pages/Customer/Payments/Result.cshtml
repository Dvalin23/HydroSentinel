@page
@model HydroSentinel.Pages.Customer.Payments.ResultModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Payment Result"; var payment = Model.Payment; }
@section Styles { <link rel="stylesheet" href="~/css/customer-subscriptions-payments.css" asp-append-version="true" /> }
@if (Model.Live)
{
    var lp = Model.LivePayment;
    <section class="billing-page"><div class="billing-intro"><div><p class="customer-eyebrow">PAYMENT RESULT</p><h2>Payment status</h2><p class="customer-lede">Status shown here comes from our server after checking with Paystack, not from the page you were redirected from.</p></div></div>
    <article class="result-panel billing-panel" role="status">
    @if (lp is null) { <h3>Payment not found</h3><p>We could not find that payment on your account.</p> }
    else if (lp.Status == "success") { <div class="result-mark" aria-hidden="true">✓</div><h3>Payment confirmed</h3><p>Reference @lp.Reference · ₦@((lp.AmountMinor / 100m).ToString("N0")) @lp.Currency · your subscription has been extended.</p> }
    else if (lp.Status == "pending") { <h3>@(Model.UnableToVerify ? "We could not reach Paystack to confirm this yet" : "Waiting for confirmation")</h3><p>Reference @lp.Reference. Nothing has been activated. Refresh in a minute; if you were charged, it will be applied when Paystack confirms it.</p> }
    else { <h3>Payment not completed</h3><p>Reference @lp.Reference · status: @lp.Status. Your subscription was not changed.</p> }
    <div class="billing-actions"><a class="customer-button customer-button-primary" asp-page="/Customer/Payments/History">Payment history</a><a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription/Index">View subscription</a></div></article></section>
}
else
{
<section class="billing-page"><div class="billing-intro"><div><p class="customer-eyebrow">DEMO PAYMENT RESULT</p><h2>Payment status</h2><p class="customer-lede">This result is simulated and cannot represent a real payment or subscription activation.</p></div><span class="billing-state billing-state-warning"><i></i>@(payment?.Status ?? "Unknown")</span></div><article class="result-panel billing-panel" role="status"><div class="result-mark" aria-hidden="true">@(payment?.Status == "success" ? "✓" : "!")</div><p class="billing-kicker">DEMONSTRATION ONLY</p><h3>@(payment is null ? "Demo payment not found" : $"Simulated payment {payment.Status}")</h3><p>@(payment is null ? "Run checkout again or reset the demo account." : $"Reference {payment.Reference} · {payment.Plan} · ₦{payment.Amount:N0} {payment.Currency}")</p><div class="billing-actions"><a class="customer-button customer-button-primary" asp-page="/Customer/Payments/History">View demo history</a><a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription">View subscription</a></div></article></section>

}
