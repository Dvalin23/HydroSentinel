@page
@model HydroSentinel.Pages.Customer.Payments.CheckoutModel
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Checkout"; }
@section Styles { <link rel="stylesheet" href="~/css/customer-subscriptions-payments.css" asp-append-version="true" /> }
@if (Model.Live)
{
<section class="billing-page"><div class="billing-intro"><div><p class="customer-eyebrow">MONTHLY SUBSCRIPTION</p><h2>Review your subscription</h2><p class="customer-lede">You will be taken to Paystack for a ₦50 card verification. We immediately request a refund; Paystack reports the refund status as it processes. Your monthly plan starts after any eligible trial or paid period.</p></div></div>
@if (Model.SelectedPlan is null) { <article class="billing-panel"><h3>Choose a plan</h3><a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription/Plans">Back to plans</a></article> }
else { <div class="billing-grid checkout-grid"><article class="billing-panel checkout-summary"><div class="billing-panel-heading"><div><p class="billing-kicker">Monthly auto-renewal</p><h3>@Model.SelectedPlan.Name plan</h3></div></div><dl class="billing-detail-list"><div><dt>Monthly service fee</dt><dd>₦@Model.SelectedPlan.MonthlyPrice.ToString("N0")</dd></div><div><dt>Device allowance</dt><dd>@Model.SelectedPlan.DeviceAllowance</dd></div><div class="billing-total"><dt>Charged monthly</dt><dd>₦@Model.LiveTotal.ToString("N0")</dd></div></dl><p class="billing-help">Hardware (₦@Model.SelectedPlan.HardwarePrice.ToString("N0")) is invoiced separately. Cancel before renewal to stop future charges; access continues through the current paid period. Failed renewals retain a 3-day grace period.</p></article>
<article class="billing-panel checkout-payment"><p class="billing-kicker">Pay with Paystack</p>@if (Model.Message is not null) { <p role="alert">@Model.Message</p> }<form method="post" class="billing-form"><input type="hidden" name="Plan" value="@Model.Plan" /><input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey" /><label><input type="checkbox" name="AcceptedRecurringTerms" value="true" required /> I authorize the ₦50 card verification charge and understand a refund will be requested. I agree to recurring monthly charges of ₦@Model.SelectedPlan.MonthlyPrice.ToString("N0") after my current trial or paid period. I can cancel before the next renewal.</label><button class="customer-button customer-button-primary" type="submit">Verify card and subscribe</button><p class="billing-help">No plan charge is made during card verification. Your first monthly charge is scheduled for the date shown in Subscription after setup.</p></form></article></div> }
<div class="billing-action-footer"><a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription/Plans">Back to plans</a></div></section>
}
else
{
<section class="billing-page"><div class="billing-intro"><div><p class="customer-eyebrow">DEMO CHECKOUT</p><h2>Review your order</h2><p class="customer-lede">Choose a simulated outcome to test the payment-result experience. No payment provider is contacted.</p></div><span class="billing-state billing-state-warning"><i></i>Demonstration only</span></div>@if (Model.SelectedPlan is null) { <article class="billing-panel"><h3>Choose a valid demo plan</h3><a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription/Plans">Back to plans</a></article> } else { <div class="billing-grid checkout-grid"><article class="billing-panel checkout-summary"><div class="billing-panel-heading"><div><p class="billing-kicker">Order summary · demo</p><h3>@Model.SelectedPlan.Name plan</h3></div></div><dl class="billing-detail-list"><div><dt>One-time setup</dt><dd>₦@Model.SelectedPlan.HardwarePrice.ToString("N0")</dd></div><div><dt>Monthly subscription</dt><dd>₦@Model.SelectedPlan.MonthlyPrice.ToString("N0")</dd></div><div><dt>Device allowance</dt><dd>@Model.SelectedPlan.DeviceAllowance</dd></div><div class="billing-total"><dt>Label</dt><dd>DEMO ONLY</dd></div></dl></article><article class="billing-panel checkout-payment"><p class="billing-kicker">Simulated payment outcome</p><h3>No credentials required</h3><form method="post" class="billing-form"><input type="hidden" name="Plan" value="@Model.Plan" /><label for="outcome">Choose result</label><select id="outcome" name="Outcome"><option value="success">Confirmed (demo)</option><option value="pending">Pending (demo)</option><option value="failed">Failed (demo)</option><option value="cancelled">Cancelled (demo)</option></select><button class="customer-button customer-button-primary" type="submit">Run simulated checkout</button><p class="billing-help">No Paystack request, card data, subscription activation, or real charge occurs.</p></form></article></div> }<div class="billing-action-footer"><a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription/Plans">Back to plans</a></div></section>

}
