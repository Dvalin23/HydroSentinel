@page
@model HydroSentinel.Pages.Customer.IndexModel
@using HydroSentinel.Services
@using HydroSentinel.Backend
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Dashboard";
    var data = Model.Data;
    var primary = Model.PrimaryDevice;
    var level = primary?.LevelPercent;
}
@section Styles { <link rel="stylesheet" href="~/css/customer-dashboard.css" asp-append-version="true" /> }
<div class="dashboard-page">
    <section class="dashboard-intro dashboard-intro-premium" aria-labelledby="dashboard-title">
        <div class="dashboard-intro-copy">
            <div class="dashboard-kicker"><span class="dashboard-kicker-mark" aria-hidden="true"></span> CUSTOMER OVERVIEW</div>
            <h2 id="dashboard-title">Your water system, at a glance.</h2>
            <p class="customer-lede">Welcome, @data.FullName. Every reading below comes from your controllers' most recent check-in.</p>
        </div>
        <div class="dashboard-intro-actions">
            <span class="customer-status-badge dashboard-connection-status"><span aria-hidden="true"></span> @(Model.OnlineCount == 0 ? "No units reporting" : $"{Model.OnlineCount} online")</span>
            <a class="customer-button customer-button-primary" asp-page="/Customer/Devices/Add">Add a device <span aria-hidden="true">&rarr;</span></a>
        </div>
    </section>

    <section class="dashboard-metrics" aria-label="Account summary">
        <a class="dashboard-metric" asp-page="/Customer/Devices/Index">
            <span class="dashboard-icon dashboard-icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 7h6M9 17h6"/></svg></span>
            <span><small>Registered devices</small><strong>@data.Devices.Count</strong><em>@Model.OnlineCount reporting now</em></span>
            <span class="dashboard-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="dashboard-metric" asp-page="/Customer/Devices/Index">
            <span class="dashboard-icon dashboard-icon-green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 0 1 14-5M20 12a8 8 0 0 1-14 5"/><path d="M18 4v4h-4M6 20v-4h4"/></svg></span>
            <span><small>Online now</small><strong>@Model.OnlineCount</strong><em>Checked in in the last 45 minutes</em></span>
            <span class="dashboard-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="dashboard-metric" asp-page="/Customer/Subscription/Index">
            <span class="dashboard-icon dashboard-icon-purple" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h3"/></svg></span>
            <span><small>Subscription</small><strong>@(data.Subscription.PlanName ?? "None")</strong><em>@CustomerPortal.StateLabel(data.Subscription.State)@(data.Subscription.IsTrial == true ? " (trial)" : "")</em></span>
            <span class="dashboard-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="dashboard-metric dashboard-metric-attention" asp-page="/Customer/Alerts/Index">
            <span class="dashboard-icon dashboard-icon-orange" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 9 17H3L12 3Z"/><path d="M12 9v4M12 17h.01"/></svg></span>
            <span><small>Open alerts</small><strong>@data.OpenAlertCount</strong><em>@(data.OpenAlertCount == 0 ? "Nothing needs attention" : "Review and acknowledge")</em></span>
            <span class="dashboard-arrow" aria-hidden="true">&rarr;</span>
        </a>
    </section>

    <section class="dashboard-pulse dashboard-panel" aria-labelledby="system-pulse-title">
        <div class="dashboard-pulse-heading">
            <div><p class="customer-eyebrow">System pulse <span class="eyebrow-dot" aria-hidden="true"></span> latest check-in</p><h3 id="system-pulse-title">Operational overview</h3></div>
            <a class="dashboard-text-link" asp-page="/Customer/Monitoring">Open monitoring <span aria-hidden="true">&rarr;</span></a>
        </div>
        @if (primary is null)
        {
            <div class="dashboard-pulse-empty">
                <span class="dashboard-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 7h6M9 17h6"/></svg></span>
                <div>
                    <strong>No devices on this account yet</strong>
                    <p>Claim the controller that came with your installation using its serial number and device key.</p>
                    <a class="customer-button customer-button-secondary" asp-page="/Customer/Devices/Add">Add a device</a>
                </div>
            </div>
        }
        else
        {
            <div class="dashboard-pulse-body">
                <div class="dashboard-pulse-device">
                    <div class="dashboard-device-heading">
                        <span class="dashboard-device-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 4h10v16H7z"/><path d="M9 7h6M9 17h6"/></svg></span>
                        <div><span class="dashboard-label">Selected device</span><h4>@primary.Name</h4><p>@primary.SerialMasked <span aria-hidden="true">&middot;</span> @(primary.LastSeenAt is null ? "Never seen" : BillingRules.FreshnessText(primary.Status))</p></div>
                        <span class="device-live-status" data-state="@primary.Status"><span aria-hidden="true"></span>@BillingRules.FreshnessText(primary.Status)</span>
                    </div>
                    <div class="dashboard-level-visual">
                        <div class="dashboard-level-top"><span>Water level</span><strong>@(level is null ? CustomerPortal.LevelLabel(primary.TankLevel) : $"{level}%")</strong></div>
                        <div class="dashboard-level-track" role="img" aria-label="Water level @(level?.ToString() ?? CustomerPortal.LevelLabel(primary.TankLevel))">
                            <span style="width:@(level ?? (primary.TankLevel == "full" ? 100 : primary.TankLevel == "mid" ? 50 : primary.TankLevel == "low" ? 20 : 0))%"></span><i aria-hidden="true"></i>
                        </div>
                        <div class="dashboard-level-meta">
                            <span>Last seen @(primary.LastSeenAt?.LocalDateTime.ToString("g") ?? "never")</span>
                            <span>@(level is null ? "Tank switch level only" : "Measured fill")</span>
                        </div>
                    </div>
                    <a class="customer-button customer-button-secondary" asp-page="/Customer/Devices/Details" asp-route-id="@primary.Id">View device details <span aria-hidden="true">&rarr;</span></a>
                </div>
                <div class="dashboard-pulse-readings" aria-label="Latest device readings">
                    <div>
                        <span class="reading-icon reading-icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3c3 4 6 7 6 11a6 6 0 0 1-12 0c0-4 3-7 6-11Z"/></svg></span>
                        <span><small>Pressure</small><strong>@(primary.PressureBar is null ? "—" : primary.PressureBar.Value.ToString("0.0"))@(primary.PressureBar is null ? "" : " bar")</strong></span>
                    </div>
                    <div>
                        <span class="reading-icon reading-icon-green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v18M5 8h14M7 8v8M17 8v8"/></svg></span>
                        <span><small>Pump status</small><strong>@(primary.PumpOn is null ? "Unknown" : primary.PumpOn == true ? "Running" : "Stopped")</strong></span>
                    </div>
                    <div>
                        <span class="reading-icon reading-icon-navy" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 18V6M4 18h16"/><path d="m7 14 3-4 3 2 4-6"/></svg></span>
                        <span><small>Signal strength</small><strong>@(primary.SignalCsq is null ? "Not reported" : $"CSQ {primary.SignalCsq}")</strong></span>
                    </div>
                    <div>
                        <span class="reading-icon reading-icon-amber" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="17" height="10" rx="2"/><path d="M21 10v4M6 10v4"/></svg></span>
                        <span><small>Battery</small><strong>@(primary.BatteryPercent is null ? "Not reported" : $"{primary.BatteryPercent}%")</strong></span>
                    </div>
                </div>
            </div>
        }
        <div class="dashboard-data-strip"><span><span class="data-strip-dot" aria-hidden="true"></span> LIVE BACKEND</span><span>Values are stored from controller check-ins. Missing readings are shown as &quot;not reported&quot;, never as zero.</span></div>
    </section>

    <section class="dashboard-content-grid" aria-label="Account activity">
        <article class="dashboard-panel dashboard-alerts-rail">
            <div class="dashboard-panel-heading"><div><p class="customer-eyebrow">Attention</p><h3>Recent alerts</h3></div><a class="dashboard-text-link" asp-page="/Customer/Alerts/Index">View all <span aria-hidden="true">&rarr;</span></a></div>
            @if (data.RecentAlerts.Count == 0)
            {
                <div class="dashboard-pulse-empty"><div><strong>No open alerts</strong><p>Your controllers have not reported anything that needs attention.</p></div></div>
            }
            else
            {
                <div class="dashboard-alert-list">
                    @foreach (var alert in data.RecentAlerts)
                    {
                        <a class="dashboard-alert-row" asp-page="/Customer/Alerts/Details" asp-route-id="@alert.Id">
                            <span class="alert-severity alert-severity-@alert.Severity" aria-hidden="true"></span>
                            <span><strong>@alert.TypeLabel</strong><small>@(alert.Detail ?? alert.DeviceName)</small></span>
                            <time datetime="@alert.At.ToString("O")">@alert.At.LocalDateTime.ToString("g")</time>
                            <span class="dashboard-row-arrow" aria-hidden="true">&rarr;</span>
                        </a>
                    }
                </div>
            }
        </article>
        <article class="dashboard-panel dashboard-subscription-rail">
            <div class="dashboard-panel-heading"><div><p class="customer-eyebrow">Account</p><h3>Current plan</h3></div><a class="dashboard-text-link" asp-page="/Customer/Subscription/Index">Manage <span aria-hidden="true">&rarr;</span></a></div>
            <div class="dashboard-plan-summary">
                <span class="plan-orbit" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/></svg></span>
                <div>
                    <strong>@(data.Subscription.PlanName ?? "No plan yet")</strong>
                    @if (data.Subscription.Exists)
                    {
                        <p>@CustomerPortal.StateLabel(data.Subscription.State)@(data.Subscription.IsTrial == true ? " · trial" : "")</p>
                        <span class="dashboard-data-note">@(data.Subscription.PaidUntil is null ? "" : $"Paid until {data.Subscription.PaidUntil.Value.LocalDateTime:d}")</span>
                    }
                    else
                    {
                        <p>Claim your first device to start the 7-day trial.</p>
                    }
                </div>
            </div>
            <a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription/Plans">Compare plans</a>
        </article>
    </section>

    <section class="dashboard-actions-section" aria-labelledby="explore-title">
        <div class="dashboard-section-heading"><div><p class="customer-eyebrow">Next steps</p><h3 id="explore-title">Shortcuts</h3></div><p>The most useful customer actions.</p></div>
        <div class="dashboard-quick-actions">
            <a asp-page="/Customer/Devices/Index"><span class="quick-action-index">01</span><span>View devices</span><span aria-hidden="true">&rarr;</span></a>
            <a asp-page="/Customer/Monitoring"><span class="quick-action-index">02</span><span>Open monitoring</span><span aria-hidden="true">&rarr;</span></a>
            <a asp-page="/Customer/Alerts/Index"><span class="quick-action-index">03</span><span>Review alerts</span><span aria-hidden="true">&rarr;</span></a>
            <a asp-page="/Customer/Notifications"><span class="quick-action-index">04</span><span>Notifications</span><span aria-hidden="true">&rarr;</span></a>
            <a asp-page="/Customer/Support/Index"><span class="quick-action-index">05</span><span>Contact support</span><span aria-hidden="true">&rarr;</span></a>
        </div>
    </section>
</div>
