@page
@model HydroSentinel.Pages.Customer.Monitoring.IndexModel
@using HydroSentinel.Backend
@using HydroSentinel.Services
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Monitoring";
    var device = Model.SelectedDevice;
}
@section Styles { <link rel="stylesheet" href="~/css/customer-monitoring-alerts.css" asp-append-version="true" /> }
<div class="monitoring-page">
    <section class="monitoring-intro">
        <div>
            <p class="customer-eyebrow">TELEMETRY</p>
            <h2>Monitoring that makes system behaviour clear.</h2>
            <p class="customer-lede">Readings stored from your controller's check-ins. Ranges are capped at the last 31 days.</p>
        </div>
        @if (device is not null)
        {
            <span class="customer-status-badge" data-state="@device.Status"><span></span>@BillingRules.FreshnessText(device.Status)</span>
        }
    </section>

    @if (Model.Devices.Count == 0)
    {
        <section class="monitoring-state-banner customer-panel">
            <div><p class="customer-eyebrow">No devices</p><h3>There is nothing to monitor yet.</h3><p>Claim a controller to start receiving readings.</p><a class="customer-button customer-button-secondary" asp-page="/Customer/Devices/Add">Add a device</a></div>
        </section>
    }
    else
    {
        <form method="get" class="monitoring-toolbar">
            <label for="monitor-device">Device</label>
            <select id="monitor-device" name="DeviceId">
                @foreach (var item in Model.Devices)
                {
                    <option value="@item.Id" selected="@(item.Id == device?.Id)">@item.Name — @item.SerialMasked</option>
                }
            </select>
            <label for="monitor-range">Range</label>
            <select id="monitor-range" name="Range">
                <option value="24h" selected="@(Model.Range == "24h")">Last 24 hours</option>
                <option value="7d" selected="@(Model.Range == "7d")">Last 7 days</option>
            </select>
            <button class="customer-button customer-button-secondary" type="submit">Refresh</button>
        </form>

        <section class="monitoring-state-banner">
            <div>
                <p class="customer-eyebrow">@device?.Name</p>
                <h3>@(device?.LastSeenAt is null ? "Awaiting the first check-in" : $"Last check-in {device.LastSeenAt.Value.LocalDateTime:g} UTC")</h3>
                <p>@(Model.Readings.Count == 0 ? "No readings fall in this range." : $"{Model.Readings.Count} readings in the selected range.")</p>
            </div>
        </section>

        <div class="monitoring-metrics">
            <article class="monitoring-metric customer-panel"><strong>Water level</strong><b>@(device?.LevelPercent is null ? CustomerPortal.LevelLabel(device?.TankLevel) : $"{device.LevelPercent}%")</b><small>Latest reading</small></article>
            <article class="monitoring-metric customer-panel"><strong>Pressure</strong><b>@CustomerPortal.PressureLabel(device?.PressureBar)</b><small>Latest reading</small></article>
            <article class="monitoring-metric customer-panel"><strong>Pump status</strong><b>@(device?.PumpOn is null ? "Unknown" : device.PumpOn == true ? "Running" : "Stopped")</b><small>Latest reading</small></article>
            <article class="monitoring-metric customer-panel"><strong>Signal / battery</strong><b>@(device?.SignalCsq is null ? "—" : $"CSQ {device.SignalCsq}") · @(device?.BatteryPercent is null ? "—" : $"{device.BatteryPercent}%")</b><small>Latest reading</small></article>
        </div>

        <article class="customer-panel monitoring-readings-panel">
            <div class="monitoring-panel-heading"><div><p class="customer-eyebrow">Historical readings</p><h3>@(Model.Range == "7d" ? "Last 7 days" : "Last 24 hours")</h3></div></div>
            @if (Model.Readings.Count == 0)
            {
                <p class="device-state-callout">Nothing recorded for this range. Choose a longer range or check that the controller is online.</p>
            }
            else
            {
                <div class="comparison-table-wrap">
                    <table class="comparison-table">
                        <thead><tr><th>Timestamp</th><th>Water level</th><th>Pressure</th><th>Pump</th><th>Mains</th><th>Battery</th><th>Signal</th></tr></thead>
                        <tbody>
                            @foreach (var reading in Model.Readings)
                            {
                                <tr>
                                    <td>@reading.At.LocalDateTime.ToString("g")</td>
                                    <td>@(reading.LevelPercent is null ? CustomerPortal.LevelLabel(reading.TankLevel) : $"{reading.LevelPercent}%")</td>
                                    <td>@(reading.PressureBar is null ? "—" : $"{reading.PressureBar:0.0} bar")</td>
                                    <td>@(reading.PumpOn ? "Running" : "Stopped")</td>
                                    <td>@(reading.MainsOn ? "Present" : "Lost")</td>
                                    <td>@(reading.BatteryPercent is null ? "—" : $"{reading.BatteryPercent}%")</td>
                                    <td>@(reading.SignalCsq is null ? "—" : $"CSQ {reading.SignalCsq}")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>

        <section class="monitoring-footer-row">
            <a class="customer-button customer-button-secondary" asp-page="/Customer/Devices/Details" asp-route-id="@device?.Id">Back to device</a>
            <a class="customer-button customer-button-secondary" asp-page="/Customer/Alerts/Index">View alerts</a>
        </section>
    }
</div>
