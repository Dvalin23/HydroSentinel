@page
@model HydroSentinel.Pages.Customer.Devices.AddModel
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Add Device";
}
@section Styles { <link rel="stylesheet" href="~/css/customer-devices.css" asp-append-version="true" /> }
<div class="device-page">
    <section class="device-page-heading">
        <div>
            <p class="customer-eyebrow">DEVICE REGISTRATION</p>
            <h2>Add a device</h2>
            <p class="customer-lede">Use the serial number printed on the controller and the device key issued during installation. The key proves the unit is yours and is never shown again.</p>
        </div>
        <a class="customer-button customer-button-secondary" asp-page="/Customer/Devices/Index">Back to My Devices</a>
    </section>

    <section class="device-form-panel">
        <div class="device-section-heading"><div><p class="customer-eyebrow">Claim a unit</p><h3>Device details</h3></div></div>
        <form method="post" class="stage7-form">
            <div asp-validation-summary="ModelOnly" class="stage7-validation" role="alert"></div>
            <div class="stage7-form-grid">
                <div class="stage7-field">
                    <label asp-for="Input.Serial"></label>
                    <input asp-for="Input.Serial" placeholder="HS-000123" autocomplete="off" />
                    <span asp-validation-for="Input.Serial" class="stage7-validation"></span>
                </div>
                <div class="stage7-field">
                    <label asp-for="Input.Key"></label>
                    <input asp-for="Input.Key" placeholder="32-character key" autocomplete="off" />
                    <span asp-validation-for="Input.Key" class="stage7-validation"></span>
                </div>
            </div>
            <p class="stage7-note">If the key is lost, contact support with your serial number. A unit can only belong to one account at a time.</p>
            <button class="customer-button customer-button-primary" type="submit">Add device to my account</button>
        </form>
    </section>

    <aside class="device-help-band">
        <div><p class="customer-eyebrow">FIRST UNIT?</p><h3>Claiming starts your 7-day trial.</h3><p>The Basic plan trial begins the moment the first controller joins your account. You can change plans later.</p></div>
        <a class="customer-button customer-button-secondary" asp-page="/Customer/Subscription/Plans">See plans</a>
    </aside>
</div>
